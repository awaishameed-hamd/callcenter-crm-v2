// CallCenter CRM v2 — Prisma Schema
// PostgreSQL · NestJS 10 · identical stack to argroup.cloud

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DIRECTOR
  MANAGER
  AGENT
}

enum ManagerType {
  REGULAR
  HR
  ACCOUNTANT
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  AUDIO
}

enum NotificationType {
  STATUS_CHANGE
  NEW_MESSAGE
  DOCUMENT
  SYSTEM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HOLIDAY
}

enum DayType {
  WORKING_DAY
  WEEKEND
  HOLIDAY
}

enum CustomerStatus {
  PENDING
  APPROVED
  DISAPPROVED
  FINAL_APPROVED
  FINAL_DISAPPROVED
}

enum Vertical {
  MEDICARE
  FINAL_EXPENSE
  ACA
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id          String      @id @default(cuid())
  userCode    String      @unique  // A001, M001, D001, ADMIN
  email       String      @unique
  phone       String?
  password    String
  displayName String
  role        Role
  managerType ManagerType @default(REGULAR)
  isActive    Boolean     @default(true)
  attendanceApplicable Boolean @default(false)

  // Password reset
  resetOtpHash  String?
  resetOtpExp   DateTime?
  resetOtpTries Int       @default(0)
  resetToken    String?   @unique
  resetTokenExp DateTime?

  avatar     String?
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Salary fields (for accounting/HR)
  basicSalary          Decimal? @db.Decimal(12, 2)
  punctualityAllowance Decimal? @db.Decimal(12, 2)
  travellingAllowance  Decimal? @db.Decimal(12, 2)
  otherAllowance       Decimal? @db.Decimal(12, 2)
  bank                 String?
  bankAccountNo        String?

  // Relations
  refreshTokens              RefreshToken[]
  messages                   Message[]
  notifications              Notification[]
  conversationParticipations ConversationParticipant[]

  attendances         Attendance[]
  editedAttendances   Attendance[]       @relation("AttendanceEdits")
  approvedAttendances Attendance[]       @relation("AttendanceApprovals")
  attendanceOpening   AttendanceOpening?

  leaveApplications LeaveApplication[] @relation("LeaveApplicant")
  leaveReviews      LeaveApplication[] @relation("LeaveReviewer")

  // CRM relations
  submittedSales  Customer[] @relation("AgentSales")
  approvedSales   Customer[] @relation("ManagerApprovals")
  finalActedSales Customer[] @relation("DirectorActions")

  @@index([role])
  @@index([email])
  @@index([userCode])
  @@map("users")
}

model SequenceCounter {
  key   String @id
  value Int    @default(0)

  @@map("sequence_counters")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Chat
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(cuid())
  isGroup       Boolean   @default(false)
  name          String?
  createdById   String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAdmin        Boolean      @default(false)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  type           MessageType  @default(TEXT)
  content        String?      @db.Text
  attachmentUrl  String?
  replyToId      String?
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]    @relation("MessageReplies")
  deletedForUserIds String[]  @default([])
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Attendance
// ─────────────────────────────────────────────────────────────────────────────

model Attendance {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workingDayId   String?
  workingDay     WorkingDay?      @relation(fields: [workingDayId], references: [id])
  date           DateTime         @db.Date
  status         AttendanceStatus @default(ABSENT)
  loginTime      DateTime?
  isLate         Boolean          @default(false)
  lateMinutes    Int?
  notes          String?
  editedById     String?
  editedBy       User?            @relation("AttendanceEdits",    fields: [editedById],    references: [id])
  approvalStatus String           @default("pending")
  approvedById   String?
  approvedBy     User?            @relation("AttendanceApprovals", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("attendances")
}

model AttendanceOpening {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  presents    Int      @default(0)
  late        Int      @default(0)
  absents     Int      @default(0)
  leaves      Int      @default(0)
  workingDays Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("attendance_openings")
}

model AttendanceSetting {
  id    String  @id @default(cuid())
  key   String  @unique
  value String
  label String?

  @@map("attendance_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Working Days
// ─────────────────────────────────────────────────────────────────────────────

model WorkingDay {
  id                    String   @id @default(cuid())
  date                  DateTime @db.Date @unique
  dayType               DayType  @default(WORKING_DAY)
  leaveReason           String?
  reportingTimeOverride String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  attendances Attendance[]

  @@map("working_days")
}

// ─────────────────────────────────────────────────────────────────────────────
// Leave
// ─────────────────────────────────────────────────────────────────────────────

model LeaveApplication {
  id              String   @id @default(cuid())
  applicantId     String
  applicant       User     @relation("LeaveApplicant", fields: [applicantId], references: [id])
  reviewedById    String?
  reviewedBy      User?    @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  leaveType       String   // sick | casual | annual | exam | other
  fromDate        DateTime @db.Date
  toDate          DateTime @db.Date
  days            Int
  reason          String   @db.Text
  status          String   @default("pending")  // pending | approved | rejected
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([applicantId])
  @@index([status])
  @@map("leave_applications")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM — Clients / DIDs
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id          String   @id @default(cuid())
  companyName String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dids Did[]

  @@map("clients")
}

model Did {
  id        String   @id @default(cuid())
  didCode   String   @unique  // e.g. DID-001
  campaign  String   // Medicare | Final Expense | ACA | Other
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]

  @@index([clientId])
  @@index([campaign])
  @@map("dids")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM — Customers (sales records)
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id           String         @id @default(cuid())
  customerCode String         @unique  // C-0000001

  // Personal info
  firstName  String
  lastName   String
  dob        DateTime?  @db.Date
  state      String?
  phone      String?
  address    String?    @db.Text

  // Policy info
  vertical      Vertical
  didId         String
  did           Did        @relation(fields: [didId], references: [id])
  policyNumber  String?
  effectiveDate DateTime?  @db.Date

  // Approval pipeline
  status       CustomerStatus @default(PENDING)
  cancelReason String?

  // Snapshot — frozen at finalApprove/finalReject so history survives DID reassignments
  saleDid         String?
  saleCompanyName String?

  // Submission timestamps in both timezones (set at create, never changed)
  submittedAtPkt String?  // "16 Oct 2025 07:30 PM PKT"
  submittedAtEst String?  // "16 Oct 2025 09:30 AM EST"

  // Actors
  agentId    String
  agent      User   @relation("AgentSales",       fields: [agentId],    references: [id])
  managerId  String?
  manager    User?  @relation("ManagerApprovals", fields: [managerId],  references: [id])
  directorId String?
  director   User?  @relation("DirectorActions",  fields: [directorId], references: [id])

  approvedAt   DateTime?
  finalActedAt DateTime?
  notes        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([status])
  @@index([vertical])
  @@index([createdAt])
  @@map("customers")
}
