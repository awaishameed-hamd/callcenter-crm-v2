// CallCenter CRM v2 — Prisma Schema
// PostgreSQL · NestJS 10 · identical stack to argroup.cloud

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DIRECTOR
  MANAGER
  AGENT
}

enum ManagerType {
  REGULAR
  HR
  ACCOUNTANT
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  AUDIO
}

enum NotificationType {
  STATUS_CHANGE
  NEW_MESSAGE
  DOCUMENT
  SYSTEM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HOLIDAY
}

enum DayType {
  WORKING_DAY
  WEEKEND
  HOLIDAY
}

enum CustomerStatus {
  PENDING
  APPROVED
  DISAPPROVED
  FINAL_APPROVED
  FINAL_DISAPPROVED
}

enum Vertical {
  MEDICARE
  FINAL_EXPENSE
  ACA
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id          String      @id @default(cuid())
  userCode    String      @unique  // A001, M001, D001, ADMIN
  email       String      @unique
  phone       String?
  password    String
  displayName String
  role        Role
  managerType ManagerType @default(REGULAR)
  isActive    Boolean     @default(true)

  // Password reset
  resetOtpHash  String?
  resetOtpExp   DateTime?
  resetOtpTries Int       @default(0)
  resetToken    String?   @unique
  resetTokenExp DateTime?

  avatar    String?
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Salary fields (for accounting/HR)
  basicSalary          Decimal? @db.Decimal(12, 2)
  punctualityAllowance Decimal? @db.Decimal(12, 2)
  travellingAllowance  Decimal? @db.Decimal(12, 2)
  otherAllowance       Decimal? @db.Decimal(12, 2)
  bank                 String?
  bankAccountNo        String?

  // Relations
  refreshTokens RefreshToken[]
  messages      Message[]
  notifications Notification[]

  attendances       Attendance[]
  editedAttendances Attendance[]       @relation("AttendanceEdits")
  attendanceOpening AttendanceOpening?

  leaveApplications LeaveApplication[] @relation("LeaveApplicant")
  leaveReviews      LeaveApplication[] @relation("LeaveReviewer")

  // CRM relations
  submittedSales  Customer[] @relation("AgentSales")
  approvedSales   Customer[] @relation("ManagerApprovals")
  finalActedSales Customer[] @relation("DirectorActions")

  @@index([role])
  @@index([email])
  @@index([userCode])
  @@map("users")
}

model SequenceCounter {
  key   String @id
  value Int    @default(0)

  @@map("sequence_counters")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Chat (copied from argroup)
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id           String    @id @default(cuid())
  participants String[]  // array of user ids
  lastMessage  String?
  lastMessageAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User        @relation(fields: [senderId], references: [id])
  type           MessageType @default(TEXT)
  content        String?     @db.Text
  fileUrl        String?
  fileName       String?
  fileSize       Int?
  isRead         Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications (copied from argroup)
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Attendance (copied from argroup)
// ─────────────────────────────────────────────────────────────────────────────

model Attendance {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime         @db.Date
  status           AttendanceStatus @default(ABSENT)
  checkIn          DateTime?
  checkOut         DateTime?
  isLate           Boolean          @default(false)
  lateMinutes      Int              @default(0)
  overtimeMinutes  Int              @default(0)
  notes            String?
  editedById       String?
  editedBy         User?            @relation("AttendanceEdits", fields: [editedById], references: [id])
  approvalStatus   String           @default("pending")  // pending | approved | rejected
  approvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("attendances")
}

model AttendanceOpening {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  openedAt  DateTime @default(now())
  ipAddress String?

  @@map("attendance_openings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Working Days (copied from argroup)
// ─────────────────────────────────────────────────────────────────────────────

model WorkingDaySetting {
  id        String  @id @default(cuid())
  dayOfWeek Int     // 0=Sun, 1=Mon … 6=Sat
  dayType   DayType @default(WORKING_DAY)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek])
  @@map("working_day_settings")
}

model HolidayOverride {
  id        String   @id @default(cuid())
  date      DateTime @db.Date @unique
  label     String
  dayType   DayType  @default(HOLIDAY)
  createdAt DateTime @default(now())

  @@map("holiday_overrides")
}

// ─────────────────────────────────────────────────────────────────────────────
// Leave (copied from argroup)
// ─────────────────────────────────────────────────────────────────────────────

model LeaveApplication {
  id         String   @id @default(cuid())
  applicantId String
  applicant   User     @relation("LeaveApplicant", fields: [applicantId], references: [id])
  reviewerId  String?
  reviewer    User?    @relation("LeaveReviewer", fields: [reviewerId], references: [id])
  leaveType   String   // CASUAL | SICK | ANNUAL | UNPAID
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  days        Int
  reason      String   @db.Text
  status      String   @default("pending")  // pending | approved | rejected
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([applicantId])
  @@index([status])
  @@map("leave_applications")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM — Clients / DIDs
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id          String   @id @default(cuid())
  companyName String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dids Did[]

  @@map("clients")
}

model Did {
  id        String   @id @default(cuid())
  didCode   String   @unique  // e.g. DID-001
  campaign  String   // Medicare | Final Expense | ACA | Other
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]

  @@index([clientId])
  @@index([campaign])
  @@map("dids")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM — Customers (sales records)
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id           String         @id @default(cuid())
  customerCode String         @unique  // C-0000001

  // Personal info
  firstName  String
  lastName   String
  dob        DateTime?  @db.Date
  state      String?
  phone      String?
  address    String?    @db.Text

  // Policy info
  vertical     Vertical
  didId        String
  did          Did        @relation(fields: [didId], references: [id])
  policyNumber String?
  effectiveDate DateTime? @db.Date

  // Approval pipeline
  status           CustomerStatus @default(PENDING)
  cancelReason     String?  // XFER | No LA | Ringing | Over Age | Out of State | Hangup | No medicare card

  // Actors
  agentId    String
  agent      User   @relation("AgentSales",        fields: [agentId],   references: [id])
  managerId  String?
  manager    User?  @relation("ManagerApprovals",  fields: [managerId], references: [id])
  directorId String?
  director   User?  @relation("DirectorActions",   fields: [directorId], references: [id])

  approvedAt       DateTime?
  finalActedAt     DateTime?
  notes            String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([status])
  @@index([vertical])
  @@index([createdAt])
  @@map("customers")
}
